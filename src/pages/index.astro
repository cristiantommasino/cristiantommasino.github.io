---
import Base from '../layouts/Base.astro';
import QuickLinks from '../components/QuickLinks.astro';
import NewsList from '../components/NewsList.astro';
import PubItem from '../components/PubItem.astro';
import CopyBibtex from '../components/CopyBibtex.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import { profile, research, news, publications, url, inlineMd, photoExists } from '../lib/data';

const hasPhoto = photoExists();
const initials = profile.name.split(' ').map((p) => p[0]).join('');
const selected = publications.filter((p) => p.selected).slice(0, 5);
const nameParts = profile.name.split(' ');
const last = nameParts.pop();
const first = nameParts.join(' ');
const paperCount = publications.filter((p) => p.type !== 'thesis' && p.type !== 'edited').length;
const stats = (profile.stats || []).map((st) => ({ ...st, value: st.value === 'auto' ? String(paperCount) : String(st.value) }));

const sameAs = [profile.links.orcid, profile.links.scholar, profile.links.github, profile.links.linkedin, profile.links.dblp, profile.lab_url].filter(Boolean);
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.links.email}`,
  url: Astro.site?.toString(),
  image: hasPhoto ? new URL(url(profile.photo), Astro.site).toString() : undefined,
  affiliation: {
    '@type': 'CollegeOrUniversity',
    name: profile.university,
    department: { '@type': 'Organization', name: profile.department },
  },
  knowsAbout: ['Computational pathology', 'Nuclei segmentation', 'Graph neural networks', 'Vision-language models', 'Knowledge graphs', 'Information retrieval'],
  sameAs,
};
---
<Base jsonld={jsonld}>
  <section class="hero-x" slot="hero" aria-labelledby="hero-name">
    <HeroCanvas />
    <div class="wrap hero-x-inner">
      <div class="hero-x-text">
        <p class="hero-x-eyebrow">{profile.department_short} · {profile.university}</p>
        <h1 id="hero-name">
          <span>{first}</span> <em>{last}</em>
        </h1>
        <p class="hero-x-role">{profile.role} · <a href={profile.lab_url} rel="noopener">{profile.lab}</a></p>
        <p class="hero-x-tagline">{profile.tagline}</p>
        <p class="hero-x-bio">{profile.bio_short}</p>
        <QuickLinks />
      </div>
      <div class="hero-x-photo">
        {hasPhoto ? (
          <img src={url(profile.photo)} alt={profile.photo_alt} width="260" height="260" />
        ) : (
          <div class="portrait-fallback" role="img" aria-label={`${profile.name} (photo coming soon)`}>{initials}</div>
        )}
      </div>
    </div>
    <p class="hero-x-hint" aria-hidden="true">Move the lens — nuclei are segmented and linked into a cell graph</p>
  </section>

  <section class="stats" aria-label="Key numbers">
    {stats.map((st) => (
      <div class="stat">
        <span class="stat-value" data-count={/^\d+$/.test(st.value) ? st.value : undefined}>{st.value}</span>
        <span class="stat-label">{st.label}</span>
        {st.note && <span class="stat-note">{st.note}</span>}
      </div>
    ))}
  </section>

  <section class="section" aria-labelledby="h-about">
    <div class="section-head"><h2 id="h-about">About</h2></div>
    <div class="prose about">
      {profile.bio_long.map((p) => <p set:html={inlineMd(p)} />)}
    </div>
  </section>

  <section class="section" aria-labelledby="h-research">
    <div class="section-head">
      <h2 id="h-research">Research</h2>
      <a class="more" href={url('research/')}>All research lines →</a>
    </div>
    <div class="grid-2">
      {research.map((r, i) => (
        <a class="card" href={url(`research/#${r.id}`)}>
          <p class="eyebrow" style="margin-bottom:0.3rem">{String(i + 1).padStart(2, '0')}</p>
          <h3>{r.title}</h3>
          <p>{r.short}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="h-news">
    <div class="section-head">
      <h2 id="h-news">News</h2>
      <a class="more" href={url('news/')}>All news →</a>
    </div>
    <NewsList items={news.slice(0, 5)} />
  </section>

  <section class="section" aria-labelledby="h-pubs">
    <div class="section-head">
      <h2 id="h-pubs">Selected publications</h2>
      <a class="more" href={url('publications/')}>All publications →</a>
    </div>
    <ul class="pub-list">
      {selected.map((p) => <PubItem pub={p} />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="h-career">
    <div class="section-head"><h2 id="h-career">Career and education</h2></div>
    <div class="grid-2" style="gap:2.5rem">
      {[
        { title: 'Positions', items: profile.experience },
        { title: 'Education', items: profile.education },
      ].map((col) => (
        <div>
          <h3 class="eyebrow" style="font-family:var(--font-mono);font-weight:400">{col.title}</h3>
          <ul class="item-list">
            {col.items.map((it) => (
              <li>
                <span>
                  <strong style="font-weight:500">{it.what}</strong><br />
                  <span class="muted">{it.where}</span>
                </span>
                <span class="when">{it.when}</span>
                {it.detail && <span class="detail" set:html={inlineMd(it.detail)} />}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
  <CopyBibtex />
</Base>
