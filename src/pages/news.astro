---
import Base from '../layouts/Base.astro';
import NewsList from '../components/NewsList.astro';
import { news, profile, url } from '../lib/data';

const years = [...new Set(news.map((n) => n.date.slice(0, 4)))];
---
<Base title="News" description={`Latest news from ${profile.name}: papers, talks and events.`}>
  <header class="page-head">
    <p class="eyebrow">News</p>
    <h1>News</h1>
    <p>Papers, talks, software releases and events. Also available as an <a href={url('feed.xml')}>RSS feed</a>.</p>
  </header>
  {years.map((y) => (
    <section class="year-group" aria-labelledby={`n${y}`}>
      <h2 id={`n${y}`}>{y}</h2>
      <NewsList items={news.filter((n) => n.date.startsWith(y))} />
    </section>
  ))}
</Base>
