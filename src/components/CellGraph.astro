---
// Logo motif: a tiny cell graph (nuclei = hematoxylin, two highlighted cells = eosin).
interface Props {
  size?: number;
  class?: string;
}
const { size = 26, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <g stroke="var(--hema)" stroke-width="1.1" opacity="0.55">
    <line x1="7" y1="8" x2="17" y2="5" /><line x1="17" y1="5" x2="25" y2="12" />
    <line x1="7" y1="8" x2="10" y2="20" /><line x1="10" y1="20" x2="20" y2="18" />
    <line x1="17" y1="5" x2="20" y2="18" /><line x1="25" y1="12" x2="20" y2="18" />
    <line x1="20" y1="18" x2="16" y2="27" /><line x1="10" y1="20" x2="16" y2="27" />
    <line x1="25" y1="12" x2="27" y2="23" /><line x1="20" y1="18" x2="27" y2="23" />
  </g>
  <g fill="var(--hema)">
    <ellipse cx="7" cy="8" rx="3" ry="2.5" /><ellipse cx="17" cy="5" rx="2.4" ry="2.9" />
    <ellipse cx="10" cy="20" rx="3" ry="2.4" /><ellipse cx="16" cy="27" rx="2.5" ry="2.3" />
    <ellipse cx="27" cy="23" rx="2.4" ry="2.7" />
  </g>
  <g fill="var(--eosin)">
    <ellipse cx="25" cy="12" rx="2.8" ry="2.5" /><ellipse cx="20" cy="18" rx="2.8" ry="3" />
  </g>
</svg>
