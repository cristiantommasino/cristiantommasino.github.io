---
// Animated "virtual microscope" behind the home hero: a field of H&E-like nuclei and a lens
// that follows the pointer. Inside the lens nuclei are segmented and linked into a cell graph.
// Purely decorative (aria-hidden); a single static frame is drawn when reduced motion is requested.
---
<canvas class="hero-canvas" aria-hidden="true"></canvas>

<script>
  type Cell = {
    ax: number; ay: number; x: number; y: number;
    rx: number; ry: number; rot: number; type: number; phase: number; speed: number;
  };

  const canvas = document.querySelector<HTMLCanvasElement>('.hero-canvas');
  const hero = canvas?.closest<HTMLElement>('.hero-x');
  const ctx = canvas?.getContext('2d');

  if (canvas && hero && ctx) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Darkfield palette: hematoxylin (violet), immune (pale lilac), stroma (eosin pink).
    const FILL = ['rgba(143,136,255,0.55)', 'rgba(214,211,255,0.55)', 'rgba(255,122,168,0.45)'];
    const LINE = ['#a9a3ff', '#ecebff', '#ff8fb8'];

    let W = 0, H = 0, dpr = 1;
    let cells: Cell[] = [];
    let tissue: HTMLCanvasElement | null = null;
    const lens = { x: 0, y: 0, tx: 0, ty: 0, r: 130 };
    let pointerActive = false;
    let running = false;
    let raf = 0;
    const t0 = performance.now();

    function buildTissue() {
      tissue = document.createElement('canvas');
      tissue.width = W * dpr;
      tissue.height = H * dpr;
      const g = tissue.getContext('2d')!;
      g.scale(dpr, dpr);
      g.fillStyle = '#0c0b14';
      g.fillRect(0, 0, W, H);
      // Soft eosin-stained tissue regions.
      for (let i = 0; i < Math.round((W * H) / 26000); i++) {
        const x = Math.random() * W, y = Math.random() * H, r = 60 + Math.random() * 160;
        const grad = g.createRadialGradient(x, y, 0, x, y, r);
        grad.addColorStop(0, `rgba(255,110,160,${0.05 + Math.random() * 0.05})`);
        grad.addColorStop(1, 'rgba(255,110,160,0)');
        g.fillStyle = grad;
        g.fillRect(x - r, y - r, r * 2, r * 2);
      }
      // Collagen fibres.
      g.strokeStyle = 'rgba(255,140,180,0.07)';
      g.lineWidth = 1;
      for (let i = 0; i < 26; i++) {
        const y = Math.random() * H;
        g.beginPath();
        g.moveTo(-20, y);
        g.bezierCurveTo(W * 0.3, y + (Math.random() - 0.5) * 140, W * 0.7, y + (Math.random() - 0.5) * 140, W + 20, y + (Math.random() - 0.5) * 60);
        g.stroke();
      }
    }

    function buildCells() {
      cells = [];
      const target = Math.max(60, Math.min(260, Math.round((W * H) / 5200)));
      let guard = 0;
      while (cells.length < target && guard++ < target * 40) {
        const x = Math.random() * W, y = Math.random() * H;
        if (cells.some((c) => (c.ax - x) ** 2 + (c.ay - y) ** 2 < 22 * 22)) continue;
        const roll = Math.random();
        const type = roll < 0.55 ? 0 : roll < 0.78 ? 1 : 2;
        const base = type === 1 ? 4.2 : type === 2 ? 4 : 7 + Math.random() * 3;
        cells.push({
          ax: x, ay: y, x, y,
          rx: type === 2 ? base * 2.1 : base,
          ry: type === 2 ? base * 0.75 : base * (0.75 + Math.random() * 0.25),
          rot: Math.random() * Math.PI, type,
          phase: Math.random() * Math.PI * 2, speed: 0.3 + Math.random() * 0.5,
        });
      }
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = hero!.clientWidth;
      H = hero!.clientHeight;
      canvas!.width = W * dpr;
      canvas!.height = H * dpr;
      lens.r = Math.max(90, Math.min(150, W * 0.11));
      buildTissue();
      buildCells();
      if (!pointerActive) {
        lens.x = lens.tx = W * 0.72;
        lens.y = lens.ty = H * 0.5;
      }
      if (!running) draw(performance.now());
    }

    function ellipse(c: Cell) {
      ctx!.beginPath();
      ctx!.ellipse(c.x, c.y, c.rx, c.ry, c.rot, 0, Math.PI * 2);
    }

    function draw(now: number) {
      const t = (now - t0) / 1000;
      const c2 = ctx!;
      c2.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (tissue) c2.drawImage(tissue, 0, 0, W, H);

      if (!reduce) {
        for (const c of cells) {
          c.x = c.ax + Math.sin(t * c.speed + c.phase) * 2.5;
          c.y = c.ay + Math.cos(t * c.speed * 0.8 + c.phase) * 2.5;
        }
        if (!pointerActive) {
          // Wander on the right, away from the text column (on phones the text is full width).
          const wide = W > 800;
          lens.tx = (wide ? W * 0.77 : W * 0.5) + Math.cos(t * 0.21) * W * (wide ? 0.12 : 0.3);
          lens.ty = H * 0.5 + Math.sin(t * 0.33) * H * (wide ? 0.3 : 0.38);
        }
        lens.x += (lens.tx - lens.x) * 0.12;
        lens.y += (lens.ty - lens.y) * 0.12;
      }

      // Raw stain outside the lens.
      for (const c of cells) {
        c2.fillStyle = FILL[c.type];
        ellipse(c);
        c2.fill();
      }

      // Inside the lens: segmentation contours + k-NN cell graph.
      const r = lens.r;
      c2.save();
      c2.beginPath();
      c2.arc(lens.x, lens.y, r, 0, Math.PI * 2);
      c2.clip();
      c2.fillStyle = 'rgba(8,7,16,0.62)';
      c2.fillRect(lens.x - r, lens.y - r, r * 2, r * 2);

      const near = cells.filter((c) => (c.x - lens.x) ** 2 + (c.y - lens.y) ** 2 < (r + 50) ** 2);
      c2.lineWidth = 1;
      c2.strokeStyle = 'rgba(255,255,255,0.38)';
      c2.beginPath();
      for (const a of near) {
        near
          .map((b) => ({ b, d: (a.x - b.x) ** 2 + (a.y - b.y) ** 2 }))
          .filter((o) => o.b !== a && o.d < 75 * 75)
          .sort((p, q) => p.d - q.d)
          .slice(0, 3)
          .forEach(({ b }) => {
            c2.moveTo(a.x, a.y);
            c2.lineTo(b.x, b.y);
          });
      }
      c2.stroke();

      for (const c of near) {
        ellipse(c);
        c2.fillStyle = FILL[c.type].replace(/[\d.]+\)$/, '0.18)');
        c2.fill();
        c2.lineWidth = 1.6;
        c2.strokeStyle = LINE[c.type];
        c2.stroke();
        c2.fillStyle = '#ffffff';
        c2.beginPath();
        c2.arc(c.x, c.y, 1.6, 0, Math.PI * 2);
        c2.fill();
      }
      c2.restore();

      // Lens ring and label.
      c2.lineWidth = 1.5;
      c2.strokeStyle = 'rgba(255,255,255,0.75)';
      c2.beginPath();
      c2.arc(lens.x, lens.y, r, 0, Math.PI * 2);
      c2.stroke();
      c2.strokeStyle = 'rgba(255,255,255,0.15)';
      c2.beginPath();
      c2.arc(lens.x, lens.y, r + 7, 0, Math.PI * 2);
      c2.stroke();
      if (W > 800) {
        c2.font = '11px "IBM Plex Mono", monospace';
        c2.fillStyle = 'rgba(255,255,255,0.7)';
        c2.fillText(`${near.length} nuclei · cell graph`, lens.x - r + 6, lens.y + r + 22);
      }
    }

    function loop(now: number) {
      draw(now);
      raf = requestAnimationFrame(loop);
    }
    function start() {
      if (running || reduce) return;
      running = true;
      raf = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    hero.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const rect = hero.getBoundingClientRect();
      lens.tx = e.clientX - rect.left;
      lens.ty = e.clientY - rect.top;
      pointerActive = true;
      if (reduce) {
        lens.x = lens.tx;
        lens.y = lens.ty;
        draw(performance.now());
      }
    });
    hero.addEventListener('pointerleave', () => (pointerActive = false));

    // Animate only while the hero is visible and the tab is in the foreground.
    new IntersectionObserver(([entry]) => (entry.isIntersecting ? start() : stop())).observe(hero);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
    // Fires once immediately, then on every size change.
    new ResizeObserver(() => resize()).observe(hero);
  }
</script>
