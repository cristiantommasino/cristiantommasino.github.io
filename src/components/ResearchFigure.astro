---
// Built-in schematic illustrations for the research lines (used when no image is provided).
// They are drawings, not real data. Colours follow the site theme.
interface Props {
  kind: string;
  alt: string;
}
const { kind, alt } = Astro.props;

// Deterministic pseudo-random generator so the drawing is identical at every build.
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

type Cell = { x: number; y: number; rx: number; ry: number; rot: number; cls: number };
function cells(seed: number, n: number, w: number, h: number, minDist: number): Cell[] {
  const r = rng(seed);
  const out: Cell[] = [];
  let guard = 0;
  while (out.length < n && guard++ < 5000) {
    const x = 18 + r() * (w - 36);
    const y = 18 + r() * (h - 36);
    if (out.some((c) => Math.hypot(c.x - x, c.y - y) < minDist)) continue;
    const cls = r() < 0.55 ? 0 : r() < 0.6 ? 1 : 2; // 0 epithelial, 1 lymphocyte, 2 stromal
    const base = cls === 1 ? 4.5 : cls === 2 ? 4 : 7.5;
    out.push({
      x,
      y,
      rx: cls === 2 ? base * 2 : base + r() * 2.5,
      ry: cls === 2 ? base * 0.75 : base * (0.75 + r() * 0.3),
      rot: Math.round(r() * 180),
      cls,
    });
  }
  return out;
}

function edges(cs: Cell[], k: number, maxD: number) {
  const set = new Set<string>();
  const res: [Cell, Cell][] = [];
  cs.forEach((a, i) => {
    cs.map((b, j) => ({ j, d: Math.hypot(a.x - b.x, a.y - b.y) }))
      .filter((o) => o.j !== i && o.d < maxD)
      .sort((p, q) => p.d - q.d)
      .slice(0, k)
      .forEach(({ j }) => {
        const id = i < j ? `${i}-${j}` : `${j}-${i}`;
        if (!set.has(id)) {
          set.add(id);
          res.push([a, cs[j]]);
        }
      });
  });
  return res;
}

const W = 480;
const H = 320;
const nucleiCells = cells(7, 70, W, H, 24);
const graphCells = cells(21, 46, W, H, 34);
const graphEdges = edges(graphCells, 3, 80);
const fibers = Array.from({ length: 9 }, (_, i) => {
  const r = rng(100 + i);
  const y = 20 + i * 34 + r() * 10;
  return `M -10 ${y.toFixed(1)} C 120 ${(y - 25 + r() * 50).toFixed(1)}, 300 ${(y - 25 + r() * 50).toFixed(1)}, 490 ${(y + r() * 20).toFixed(1)}`;
});
const fill = (c: Cell) => (c.cls === 0 ? 'var(--hema)' : c.cls === 1 ? 'var(--ink-2)' : 'var(--eosin)');
---
<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={alt} preserveAspectRatio="xMidYMid slice">
  <title>{alt}</title>
  {kind === 'nuclei' && (
    <>
      <rect width={W} height={H} fill="var(--eosin-soft)" />
      <g fill="none" stroke="var(--eosin)" stroke-width="1" opacity="0.25">
        {fibers.map((d) => <path d={d} />)}
      </g>
      <g>
        {nucleiCells.map((c) =>
          c.x < W / 2 ? (
            <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} transform={`rotate(${c.rot} ${c.x} ${c.y})`} fill="var(--hema)" opacity={c.cls === 2 ? 0.55 : 0.8} />
          ) : (
            <ellipse cx={c.x} cy={c.y} rx={c.rx} ry={c.ry} transform={`rotate(${c.rot} ${c.x} ${c.y})`} fill={fill(c)} fill-opacity="0.18" stroke={fill(c)} stroke-width="1.8" />
          ),
        )}
      </g>
      <line x1={W / 2} y1="0" x2={W / 2} y2={H} stroke="var(--ink)" stroke-width="1.2" stroke-dasharray="4 4" opacity="0.5" />
      <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
        <rect x="10" y="10" width="78" height="20" rx="3" fill="var(--surface)" opacity="0.92" />
        <text x="18" y="24">H&amp;E tile</text>
        <rect x={W / 2 + 10} y="10" width="112" height="20" rx="3" fill="var(--surface)" opacity="0.92" />
        <text x={W / 2 + 18} y="24">nuclei detected</text>
      </g>
      <g font-family="var(--font-mono)" font-size="10.5" fill="var(--ink)">
        <rect x={W / 2 + 10} y={H - 34} width="226" height="24" rx="3" fill="var(--surface)" opacity="0.92" />
        <circle cx={W / 2 + 22} cy={H - 22} r="4" fill="var(--hema)" /><text x={W / 2 + 30} y={H - 18}>epithelial</text>
        <circle cx={W / 2 + 104} cy={H - 22} r="4" fill="var(--ink-2)" /><text x={W / 2 + 112} y={H - 18}>immune</text>
        <circle cx={W / 2 + 170} cy={H - 22} r="4" fill="var(--eosin)" /><text x={W / 2 + 178} y={H - 18}>stromal</text>
      </g>
    </>
  )}
  {kind === 'graph' && (
    <>
      <rect width={W} height={H} fill="var(--surface)" />
      <g fill="none" stroke="var(--eosin)" stroke-width="1" opacity="0.15">
        {fibers.map((d) => <path d={d} />)}
      </g>
      <g stroke="var(--hema)" stroke-width="1.2" opacity="0.45">
        {graphEdges.map(([a, b]) => <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} />)}
      </g>
      <g>
        {graphCells.map((c) => (
          <ellipse cx={c.x} cy={c.y} rx={Math.min(c.rx, 8)} ry={Math.min(c.ry, 6.5)} transform={`rotate(${c.rot} ${c.x} ${c.y})`} fill={fill(c)} />
        ))}
      </g>
      <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
        <rect x="10" y="10" width="196" height="20" rx="3" fill="var(--surface-2)" />
        <text x="18" y="24">node = nucleus · edge = neighbour</text>
      </g>
    </>
  )}
  {kind === 'vlm' && (
    <>
      <rect width={W} height={H} fill="var(--surface)" />
      <g>
        <rect x="24" y="70" width="110" height="110" rx="6" fill="var(--eosin-soft)" stroke="var(--rule-strong)" />
        {cells(3, 16, 110, 110, 20).map((c) => (
          <ellipse cx={24 + c.x} cy={70 + c.y} rx={Math.min(c.rx, 7)} ry={Math.min(c.ry, 5.5)} transform={`rotate(${c.rot} ${24 + c.x} ${70 + c.y})`} fill="var(--hema)" opacity="0.8" />
        ))}
        <rect x="24" y="196" width="110" height="52" rx="6" fill="var(--surface-2)" stroke="var(--rule-strong)" />
        <text x="34" y="216" font-family="var(--font-sans)" font-size="11" fill="var(--ink)">“Is this region</text>
        <text x="34" y="232" font-family="var(--font-sans)" font-size="11" fill="var(--ink)">tumour?”</text>
      </g>
      <g stroke="var(--ink-3)" stroke-width="1.4" fill="none">
        <path d="M140 125 H178" /><path d="M140 222 H160 V160 H178" />
        <path d="M300 160 H330" /><path d="M172 120 l6 5 -6 5M172 155 l6 5 -6 5M324 155 l6 5 -6 5" />
      </g>
      <rect x="180" y="96" width="120" height="128" rx="8" fill="var(--hema-soft)" stroke="var(--hema)" />
      <text x="240" y="150" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--hema)">vision-language</text>
      <text x="240" y="167" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="var(--hema)">model</text>
      <rect x="332" y="104" width="128" height="112" rx="8" fill="var(--surface-2)" stroke="var(--rule-strong)" />
      <text x="344" y="126" font-family="var(--font-mono)" font-size="11" fill="var(--ink-3)">decision</text>
      <text x="344" y="150" font-family="var(--font-sans)" font-size="15" font-weight="600" fill="var(--ink)">Tumour</text>
      <rect x="344" y="164" width="104" height="8" rx="4" fill="var(--rule)" />
      <rect x="344" y="164" width="86" height="8" rx="4" fill="var(--eosin)" />
      <text x="344" y="196" font-family="var(--font-mono)" font-size="11" fill="var(--ink-3)">confidence 0.83</text>
    </>
  )}
  {kind === 'kg' && (
    <>
      <rect width={W} height={H} fill="var(--surface)" />
      <g stroke="var(--rule-strong)" stroke-width="1.5">
        <line x1="110" y1="90" x2="240" y2="160" /><line x1="110" y1="240" x2="240" y2="160" />
        <line x1="240" y1="160" x2="380" y2="80" /><line x1="240" y1="160" x2="390" y2="230" />
        <line x1="380" y1="80" x2="390" y2="230" /><line x1="110" y1="90" x2="110" y2="240" />
      </g>
      <g font-family="var(--font-mono)" font-size="10" fill="var(--ink-3)">
        <text x="150" y="112">depicts</text><text x="152" y="215">mentions</text>
        <text x="300" y="108">is_a</text><text x="306" y="205">part_of</text>
      </g>
      <g>
        <rect x="70" y="58" width="80" height="64" rx="6" fill="var(--eosin-soft)" stroke="var(--eosin)" />
        {cells(9, 6, 80, 64, 20).map((c) => (
          <ellipse cx={70 + c.x} cy={58 + c.y} rx="5" ry="4" fill="var(--hema)" opacity="0.8" />
        ))}
        <rect x="74" y="212" width="72" height="58" rx="6" fill="var(--surface-2)" stroke="var(--rule-strong)" />
        <g stroke="var(--ink-3)" stroke-width="2"><line x1="84" y1="228" x2="134" y2="228" /><line x1="84" y1="240" x2="128" y2="240" /><line x1="84" y1="252" x2="120" y2="252" /></g>
      </g>
      <g font-family="var(--font-sans)" font-size="12" text-anchor="middle">
        <circle cx="240" cy="160" r="40" fill="var(--hema-soft)" stroke="var(--hema)" />
        <text x="240" y="157" fill="var(--hema)">carcinoma</text><text x="240" y="172" fill="var(--hema)" font-size="10.5">concept</text>
        <circle cx="380" cy="80" r="32" fill="var(--hema-soft)" stroke="var(--hema)" />
        <text x="380" y="84" fill="var(--hema)">tumour</text>
        <circle cx="390" cy="230" r="34" fill="var(--hema-soft)" stroke="var(--hema)" />
        <text x="390" y="234" fill="var(--hema)">breast</text>
      </g>
      <g font-family="var(--font-mono)" font-size="10" fill="var(--ink-3)">
        <text x="70" y="50">image</text><text x="74" y="288">document</text>
      </g>
    </>
  )}
</svg>
