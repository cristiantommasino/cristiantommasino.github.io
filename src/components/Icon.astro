---
// Small outline icon set (24×24, stroke = currentColor). Decorative by default.
interface Props {
  name: string;
  label?: string;
}
const { name, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' };
---
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" {...a11y}>
  {name === 'email' && (<><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6.5 8.5-6.5" /></>)}
  {name === 'scholar' && (<><path d="M2 9.5 12 4l10 5.5-10 5.5z" /><path d="M6 11.7V16c0 1.4 2.7 3 6 3s6-1.6 6-3v-4.3" /></>)}
  {name === 'orcid' && (<><circle cx="12" cy="12" r="9.2" /><path d="M8.6 10.2v6M8.6 7.6v.1M11.4 16.2v-6h2.1a3 3 0 0 1 0 6z" /></>)}
  {name === 'github' && (<><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" /></>)}
  {name === 'linkedin' && (<><rect x="3" y="3" width="18" height="18" rx="2.5" /><path d="M8 10.5V16M8 7.8v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16" /></>)}
  {name === 'cv' && (<><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M12 11v6M9.5 14.5 12 17l2.5-2.5" /></>)}
  {name === 'dblp' && (<><path d="M4 5.5A1.5 1.5 0 0 1 5.5 4H19v14H5.5A1.5 1.5 0 0 0 4 19.5zM4 19.5A1.5 1.5 0 0 0 5.5 21H19" /><path d="M8 8h7M8 11h5" /></>)}
  {name === 'web' && (<><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></>)}
  {name === 'sun' && (<><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></>)}
  {name === 'moon' && (<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />)}
  {name === 'menu' && (<path d="M4 7h16M4 12h16M4 17h16" />)}
  {name === 'pin' && (<><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.3" /></>)}
  {name === 'arrow' && (<path d="M5 12h14M13 6l6 6-6 6" />)}
</svg>
